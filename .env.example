# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase "Session pooler" connection strings (Connect -> Direct Connection string)
DATABASE_URL_ADMIN=postgresql://postgres.<project-ref>:<admin-password>@<pooler-host>:5432/postgres
DATABASE_URL_READONLY=postgresql://ai_readonly.<project-ref>:<readonly-password>@<pooler-host>:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=<model name from OpenAI's pricing page>
# Optional: use a different model for the answer-writing step
# OPENAI_ANSWER_MODEL=
# Optional: USD per 1M tokens, for cost estimates
# PRICE_IN_PER_M=
# PRICE_OUT_PER_M=
